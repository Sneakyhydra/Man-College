# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared admin desk login (8h session; rotate password regularly)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-secret

# App Twilio SMS (booking confirmations + reminder cron). Separate from Supabase Auth phone OTP provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel cron: Authorization Bearer for /api/cron/reminders
CRON_SECRET=long-random-cron-secret
